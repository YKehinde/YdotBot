# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here

# Twitch Integration
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_CHANNEL=your_twitch_username_here
# One-time value — get it by running `npm run twitch:auth`.
# After the first successful run the bot persists its own refreshed
# copy to data/twitch-user-token.json and this value is no longer read.
TWITCH_REFRESH_TOKEN=your_twitch_refresh_token_here

# Overlay Server
OVERLAY_PORT=3001
OVERLAY_SECRET=generate_a_random_secret_key_here

# Database
DATABASE_PATH=./data/bot.db

# Discord
DISCORD_SERVER_URL=https://discord.gg/your-invite-code

# Environment
NODE_ENV=production
